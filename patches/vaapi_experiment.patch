+bool FfmpegVideoDecoderImpl<FFMPEG>::ProcessHwFrame(const AVFrame& av_frame) {
+#if SB_FFMPEG_HAS_VAAPI
+  const AVFrame* src = &av_frame;
+  if (!hw_pool_logged_ && av_frame.hw_frames_ctx) {
+    // One-time dump of the GPU surface pool, to explain GPU-side memory.
+    const AVHWFramesContext* pool =
+        reinterpret_cast<const AVHWFramesContext*>(av_frame.hw_frames_ctx->data);
+    SB_LOG(INFO) << "VA-API surface pool: initial_pool_size="
+                 << pool->initial_pool_size << " size=" << pool->width << "x"
+                 << pool->height << " sw_format=" << pool->sw_format
+                 << " (NV12=" << AV_PIX_FMT_NV12 << ")";
+    hw_pool_logged_ = true;
+  }
+  if (av_frame.format == AV_PIX_FMT_VAAPI) {
+    if (!sw_frame_) {
+      sw_frame_ = ffmpeg_->av_frame_alloc();
+    }
+    ffmpeg_->av_frame_unref(sw_frame_);
+    const int rv = GetHwApi().hwframe_transfer_data(sw_frame_, &av_frame, 0);
+    if (rv < 0) {
+      error_cb_(kSbPlayerErrorDecode,
+                FormatString("av_hwframe_transfer_data() failed: %d", rv));
+      error_occurred_ = true;
+      return false;
+    }
+    src = sw_frame_;
+  }
+
+  const int width = av_frame.width;
+  const int height = av_frame.height;
+  const int uv_width = (width + 1) / 2;
+  const int uv_height = (height + 1) / 2;
+  const uint8_t* u = nullptr;
+  const uint8_t* v = nullptr;
+  int uv_pitch = 0;
+  if (src->format == AV_PIX_FMT_NV12) {
+    // Deinterleave UV into the planar layout CpuVideoFrame expects.
+    chroma_planes_.resize(static_cast<size_t>(uv_width) * uv_height * 2);
+    uint8_t* u_plane = chroma_planes_.data();
+    uint8_t* v_plane = u_plane + static_cast<size_t>(uv_width) * uv_height;
+    for (int row = 0; row < uv_height; ++row) {
+      const uint8_t* uv = src->data[1] + row * src->linesize[1];
+      for (int col = 0; col < uv_width; ++col) {
+        u_plane[row * uv_width + col] = uv[col * 2];
+        v_plane[row * uv_width + col] = uv[col * 2 + 1];
+      }
+    }
+    u = u_plane;
+    v = v_plane;
+    uv_pitch = uv_width;
+  } else if (src->format == AV_PIX_FMT_YUV420P) {
+    // FFmpeg fell back to software decoding.
+    u = src->data[1];
+    v = src->data[2];
+    uv_pitch = src->linesize[1];
+  } else {
+    error_cb_(kSbPlayerErrorDecode,
+              FormatString("Unsupported VA-API output format %d", src->format));
+    error_occurred_ = true;
+    return false;
+  }
+
+  int64_t frame_pts = av_frame.pts;
+#if LIBAVCODEC_VERSION_MAJOR < 61
+  if (frame_pts == AV_NOPTS_VALUE) {
+    frame_pts = av_frame.reordered_opaque;
+  }
+#endif
+  scoped_refptr<CpuVideoFrame> frame = CpuVideoFrame::CreateYV12Frame(
+      /*bit_depth=*/8, width, height, src->linesize[0], uv_pitch, frame_pts,
+      src->data[0], u, v);
+  if (output_mode_ == kSbPlayerOutputModeDecodeToTexture) {
+    std::lock_guard lock(decode_target_and_frames_mutex_);
+    frames_.push(frame);
+  }
+  decoder_status_cb_(kBufferFull, frame);
+  return true;
+#else   // SB_FFMPEG_HAS_VAAPI
+  // Old FFmpeg/libav: the VA-API members exist but are never set.
+  (void)hw_device_ctx_;
+  (void)sw_frame_;
+  (void)hw_pool_logged_;
+  return false;
+#endif  // SB_FFMPEG_HAS_VAAPI
+}
